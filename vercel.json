{
     "version": 2,
     "builds": [
       {
         "src": "api/main.py",
         "use": "@vercel/python",
         "config": { "maxLambdaSize": "15mb" }
       },
       {
         "src": "src/index.js",
         "use": "@vercel/node"
       }
     ],
     "routes": [
       {
         "src": "/(.*)",
         "dest": "api/main.py"
       }
     ]
   }